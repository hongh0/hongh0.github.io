        <div class="results-grid"><div class="grid-item is-sim"><video muted loop playsinline preload="none" poster="./static/images/posters/029/simulation.jpg" data-src="./static/videos/cases/029/simulation.mp4"></video></div><div class="grid-item "><video muted loop playsinline preload="none" poster="./static/images/posters/029/physgen3d.jpg" data-src="./static/videos/cases/029/physgen3d.mp4"></video></div><div class="grid-item "><video muted loop playsinline preload="none" poster="./static/images/posters/029/wonderplay.jpg" data-src="./static/videos/cases/029/wonderplay.mp4"></video></div><div class="grid-item "><video muted loop playsinline preload="none" poster="./static/images/posters/029/baseline_vace.jpg" data-src="./static/videos/cases/029/baseline_vace.mp4"></video></div><div class="grid-item is-ours"><video muted loop playsinline preload="none" poster="./static/images/posters/029/ours_vace.jpg" data-src="./static/videos/cases/029/ours_vace.mp4"></video></div><div class="grid-item "><video muted loop playsinline preload="none" poster="./static/images/posters/029/baseline_tora.jpg" data-src="./static/videos/cases/029/baseline_tora.mp4"></video></div><div class="grid-item is-ours"><video muted loop playsinline preload="none" poster="./static/images/posters/029/ours_tora.jpg" data-src="./static/videos/cases/029/ours_tora.mp4"></video></div><div class="grid-item "><video muted loop playsinline preload="none" poster="./static/images/posters/029/baseline_wanmove.jpg" data-src="./static/videos/cases/029/baseline_wanmove.mp4"></video></div><div class="grid-item is-ours"><video muted loop playsinline preload="none" poster="./static/images/posters/029/ours_wanmove.jpg" data-src="./static/videos/cases/029/ours_wanmove.mp4"></video></div></div>
