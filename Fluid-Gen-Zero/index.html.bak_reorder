<section class="section" id="bibtex"><div class="container is-max-desktop content"><h2 class="title">BibTeX</h2><pre><code>@inproceedings{fluidgenzero2026,
  title     = {Fluid-Gen-Zero: Grounding Pretrained Video Generators in Physics without Training},
  author    = {Huang, Hong and Liu, Yuqiu and You, Chenyu and Martin, Daniel F and Zou, Chuhang and Chen, Wuyang},
  booktitle = {arXiv},
  year      = {2026},
}</code></pre></div></section>
<footer class="footer"><div class="container"><div class="content has-text-centered"><p>Fluid-Gen-Zero</p><p>Website adapted from the <a href="https://github.com/nerfies/nerfies.github.io">Nerfies project page template</a>.</p></div></div></footer>
<script>
// Rows are fetched just before they scroll into view and paused once they
// leave; a hundred-odd clips cannot all decode at once. Every video in a row
// starts together, which is what makes the columns comparable.
(function () {
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      var vids = e.target.querySelectorAll('video');
      if (e.isIntersecting) {
        vids.forEach(function (v) {
          if (v.dataset.src) { v.src = v.dataset.src; delete v.dataset.src; }
          v.play().catch(function () {});
        });
      } else {
        vids.forEach(function (v) { v.pause(); });
      }
    });
  }, { rootMargin: '500px 0px' });
  document.querySelectorAll('.row-container').forEach(function (r) { io.observe(r); });
})();

// Showcase: the arrow is the control. Pressing it applies that scene's force
// and runs the clip; nothing is fetched until then.
(function () {
  var scenes = document.querySelectorAll('.showcase-scene');
  if (!scenes.length) return;

  function start(scene) {
    var v = scene.querySelector('video');
    if (v.dataset.src) { v.src = v.dataset.src; delete v.dataset.src; }
    scene.querySelector('.showcase-stage').classList.add('is-playing');
    v.currentTime = 0;
    v.play().catch(function () {});
  }

  scenes.forEach(function (scene) {
    scene.querySelector('.showcase-stage').addEventListener('click', function () {
      start(scene);
    });
  });

  document.querySelectorAll('.showcase-tab').forEach(function (tab) {
    tab.addEventListener('click', function () {
      var id = tab.dataset.scene;
      document.querySelectorAll('.showcase-tab').forEach(function (t) {
        t.classList.toggle('is-active', t === tab);
      });
      scenes.forEach(function (s) {
        var on = s.dataset.scene === id;
        s.classList.toggle('is-active', on);
        if (!on) {
          s.querySelector('video').pause();
          s.querySelector('.showcase-stage').classList.remove('is-playing');
        }
      });
    });
  });
})();
</script>
</body>
</html>
