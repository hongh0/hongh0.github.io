<section class="hero teaser">
  <div class="container is-max-desktop">
    <div class="hero-body">
      <div class="teaser-card">
        <div class="teaser-copy"><span class="dnerf">Fluid-Gen-Zero</span> brings simulation-grounded physical control to pretrained video generators without updating their parameters.</div>
        <div class="teaser-pills"><span>Training-free</span><span>Simulation-grounded</span><span>Plug-and-play</span></div>
      </div>
    </div>
